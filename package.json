{
  "name": "xplink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @xplink/web dev",
    "build": "pnpm --filter @xplink/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps/web/src packages/matrix-adapter/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run packages/matrix-adapter/src && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "docs:generate": "node scripts/generate-file-index.mjs",
    "docs:check": "node scripts/generate-file-index.mjs --check && node scripts/verify-repo-map.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "5.1.0"
  }
}
