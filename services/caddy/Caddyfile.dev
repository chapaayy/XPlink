:8080 {
  encode zstd gzip

  handle_path /livekit/jwt/* {
    reverse_proxy lk-jwt:8080
  }
  handle_path /livekit/sfu/* {
    reverse_proxy livekit:7880
  }

  @matrix path /_matrix/*
  handle @matrix {
    reverse_proxy synapse:8008
  }

  handle {
    reverse_proxy web:5173
  }

  # DEV ONLY: Vite's @vitejs/plugin-react injects an inline React Refresh preamble.
  # Never copy this CSP to production: serve a static build with a strict script policy.
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
    Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:8080 ws://xplink.localhost:8080; img-src 'self' data: blob:; worker-src 'self' blob:; font-src 'self'"
  }
}
