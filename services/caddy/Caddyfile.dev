:8080 {
  encode zstd gzip

  @matrix path /_matrix/*
  handle @matrix {
    reverse_proxy synapse:8008
  }

  handle {
    reverse_proxy web:5173
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:8080; img-src 'self' data: blob:; worker-src 'self' blob:; font-src 'self'"
  }
}
